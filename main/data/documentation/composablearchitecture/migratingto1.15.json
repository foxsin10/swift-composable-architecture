verview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The library is now 100% Swift 6 compatible, and has been done in a way that is full backwards"},{"type":"text","text":" "},{"type":"text","text":"compatible. If your project does not have strict concurrency warnings turned on, then updating"},{"type":"text","text":" "},{"type":"text","text":"the Composable Architecture to 1.15.0 should not cause any compilation errors. However, if you have"},{"type":"text","text":" "},{"type":"text","text":"strict concurrency turned on, then you may come across a few situations you need to update."}]},{"type":"heading","anchor":"Enum-cases-as-function-references","text":"Enum cases as function references","level":3},{"type":"paragraph","inlineContent":[{"text":"It is common to use the case of enum as a function, such as mapping on an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/ComposableArchitecture\/documentation\/ComposableArchitecture\/Effect"},{"text":" to bundle","type":"text"},{"text":" ","type":"text"},{"text":"its output into an action:","type":"text"}]},{"type":"codeListing","code":["return client.fetch()","  .map(Action.response)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In strict concurrency mode this may fail with a message like this:"}]},{"name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"🛑 Converting non-sendable function value to ‘@Sendable (Value) -> Action’ may introduce data races","type":"text"}]}],"style":"note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"There are two ways to fix this. You can either open the closure explicitly instead of using"},{"type":"text","text":" "},{"code":"Action.response","type":"codeVoice"},{"type":"text","text":" as a function:"}]},{"type":"codeListing","code":["return client.fetch()","  .map { .response($0) }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"There is also an upcoming Swift feature that will fix this. You can enable it in an SPM package"},{"type":"text","text":" "},{"type":"text","text":"by adding a "},{"type":"codeVoice","code":"enableUpcomingFeature"},{"type":"text","text":" to its Swift settings:"}]},{"type":"codeListing","code":["swiftSettings: [","  .enableUpcomingFeature(\"InferSendableFromCaptures\"),","]),"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"And you can "},{"identifier":"https:\/\/www.swift.org\/blog\/using-upcoming-feature-flags\/","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"by navigating to your project’s build settings in Xcode, and adding a new “Other Swift Flags” flag:"}],"type":"paragraph"},{"code":["-enable-upcoming-feature InferSendableFromCaptures"],"syntax":null,"type":"codeListing"}]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ComposableArchitecture\/documentation\/ComposableArchitecture\/MigratingTo1.15"},"abstract":[{"type":"text","text":"The library has been completely updated for Swift 6 language mode, and now compiles in strict"},{"type":"text","text":" "},{"type":"text","text":"concurrency with no warnings or errors."}],"references":{"https://www.swift.org/blog/using-upcoming-feature-flags/":{"type":"link","identifier":"https:\/\/www.swift.org\/blog\/using-upcoming-feature-flags\/","title":"enable this feature in Xcode","titleInlineContent":[{"text":"enable this feature in Xcode","type":"text"}],"url":"https:\/\/www.swift.org\/blog\/using-upcoming-feature-flags\/"},"doc://ComposableArchitecture/documentation/ComposableArchitecture/MigratingTo1.7":{"title":"Migrating to 1.7","url":"\/documentation\/composablearchitecture\/migratingto1.7","kind":"article","identifier":"doc:\/\/ComposableArchitecture\/documentation\/ComposableArchitecture\/MigratingTo1.7","role":"article","type":"topic","abstract":[{"typ