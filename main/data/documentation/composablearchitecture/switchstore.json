":"codeListing","syntax":"swift"},{"style":"important","name":"Important","type":"aside","content":[{"inlineContent":[{"text":"The ","type":"text"},{"code":"SwitchStore","type":"codeVoice"},{"text":" view builder is only evaluated when the case of state passed to","type":"text"},{"text":" ","type":"text"},{"text":"it changes. As such, you should not rely on this value for anything other than checking the","type":"text"},{"text":" ","type":"text"},{"text":"current case, ","type":"text"},{"inlineContent":[{"type":"text","text":"e.g."}],"type":"emphasis"},{"text":" by switching on it and routing to an appropriate ","type":"text"},{"code":"CaseLet","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"inlineContent":[{"type":"text","text":"See "},{"type":"codeVoice","code":"Reducer\/ifCaseLet(_:action:then:fileID:filePath:line:column:)-7sg8d"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"Scope\/init(state:action:child:fileID:filePath:line:column:)-9g44g"},{"type":"text","text":" for embedding reducers"},{"type":"text","text":" "},{"type":"text","text":"that operate on each case of an enum in reducers that operate on the entire enum."}],"type":"paragraph"}]}],"references":{"doc://ComposableArchitecture/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/ComposableArchitecture\/s8SendableP"},"doc://ComposableArchitecture/7SwiftUI4ViewP":{"type":"unresolvable","title":"SwiftUICore.View","identifier":"doc:\/\/ComposableArchitecture\/7SwiftUI4ViewP"},"doc://ComposableArchitecture/documentation/ComposableArchitecture/SwiftUIDeprecations":{"role":"collectionGroup","kind":"article","identifier":"doc:\/\/ComposableArchitecture\/documentation\/ComposableArchitecture\/SwiftUIDeprecations","title":"Deprecations","type":"topic","url":"\/documentation\/composablearchitecture\/swiftuideprecations","abstract":[{"type":"text","text":"Review unsupported SwiftUI APIs and their replacements."}]},"doc:/